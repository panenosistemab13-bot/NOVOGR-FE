function getSessionUser(){const email=(Session.getActiveUser().getEmail()||'').trim().toLowerCase();if(!email)return {authenticated:false,email:'',message:'Google não retornou o e-mail da sessão. Configure a implantação para exigir login Google.'};const allow=JSON.parse(PropertiesService.getScriptProperties().getProperty('NOVOGR_ALLOWED_USERS')||'[]');const user=allow.find(u=>u.email===email);if(!user)return {authenticated:false,email,email,message:'Seu e-mail ainda não foi liberado para este aplicativo.'};return {authenticated:true,email,name:user.name||email,role:user.role||'Agente de Risco',allowedPages:user.allowedPages||[]};}
function getCurrentUser(){return getSessionUser();}
function setUserAllowlist(users){const caller=(Session.getActiveUser().getEmail()||'').toLowerCase();if(!caller)throw new Error('E-mail da sessão indisponível.');const allow=JSON.parse(PropertiesService.getScriptProperties().getProperty('NOVOGR_ALLOWED_USERS')||'[]');if(!allow.some(u=>u.email===caller&&u.role==='Administrador'))throw new Error('Somente administrador pode gerenciar acessos.');if(!Array.isArray(users))throw new Error('Lista de usuários inválida.');const clean=users.map(u=>({email:String(u.email||'').trim().toLowerCase(),name:String(u.name||''),role:u.role==='Administrador'?'Administrador':'Agente de Risco',allowedPages:Array.isArray(u.allowedPages)?u.allowedPages:[]})).filter(u=>u.email.includes('@'));PropertiesService.getScriptProperties().setProperty('NOVOGR_ALLOWED_USERS',JSON.stringify(clean));return {saved:clean.length};}
function requireAuthenticated(){const user=getSessionUser();if(!user.authenticated)throw new Error(user.message||'Acesso não autorizado.');return user;}
