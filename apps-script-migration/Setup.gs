function setupSystem(){const props=PropertiesService.getScriptProperties();let ss;const id=props.getProperty('NOVOGR_DB_ID');if(id){ss=SpreadsheetApp.openById(id);}else{ss=SpreadsheetApp.create(NOVOGR_CONFIG.SHEET_NAME);props.setProperty('NOVOGR_DB_ID',ss.getId());}NOVOGR_CONFIG.TABLES.forEach(name=>{let sh=ss.getSheetByName(name)||ss.insertSheet(name);if(sh.getLastRow()===0){sh.appendRow(['ID','DATA_CRIACAO','DATA_ATUALIZACAO','USUARIO','STATUS','DADOS_JSON']);sh.setFrozenRows(1);sh.getRange(1,1,1,6).setFontWeight('bold');}});let folder=DriveApp.getFoldersByName(NOVOGR_CONFIG.DRIVE_FOLDER);let f=folder.hasNext()?folder.next():DriveApp.createFolder(NOVOGR_CONFIG.DRIVE_FOLDER);props.setProperty('NOVOGR_FOLDER_ID',f.getId());return {spreadsheet:ss.getUrl(),folder:f.getUrl(),tables:NOVOGR_CONFIG.TABLES};}