function doGet(){return HtmlService.createTemplateFromFile('Index').evaluate().setTitle(NOVOGR_CONFIG.APP_NAME).setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);}function include(file){return HtmlService.createHtmlOutputFromFile(file).getContent();}function getInitialData(){return {appName:NOVOGR_CONFIG.APP_NAME,modules:NOVOGR_CONFIG.TABLES};}function listRecords(table){requireAuthenticated();if(!NOVOGR_CONFIG.TABLES.includes(table))throw new Error('Tabela inválida');const id=PropertiesService.getScriptProperties().getProperty('NOVOGR_DB_ID');if(!id)throw new Error('Execute setupSystem primeiro');const sh=SpreadsheetApp.openById(id).getSheetByName(table);if(sh.getLastRow()<2)return [];return sh.getRange(2,1,sh.getLastRow()-1,6).getValues().map(r=>({id:r[0],created:r[1],updated:r[2],user:r[3],status:r[4],data:JSON.parse(r[5]||'{}')}));}function saveRecord(table,data){const user=requireAuthenticated();if(!NOVOGR_CONFIG.TABLES.includes(table))throw new Error('Tabela inválida');const id=PropertiesService.getScriptProperties().getProperty('NOVOGR_DB_ID');if(!id)throw new Error('Execute setupSystem primeiro');const sh=SpreadsheetApp.openById(id).getSheetByName(table);const now=new Date(),uid=Utilities.getUuid();sh.appendRow([uid,now,now,user.email,'ATIVO',JSON.stringify(data)]);return uid;}